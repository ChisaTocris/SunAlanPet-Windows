<Window x:Class="SunAlanPet.Windows.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Manual" ShowActivated="False"
        MouseLeftButtonDown="OnLeftButtonDown" MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnLeftButtonUp" MouseRightButtonUp="OnRightButtonUp">
  <Border Background="Transparent">
    <Grid>
      <Image x:Name="PetImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
             Margin="0,44,0,0" RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform>
          <TransformGroup>
            <RotateTransform x:Name="PetRotation" Angle="0" />
            <TranslateTransform x:Name="PetTranslation" X="0" Y="0" />
          </TransformGroup>
        </Image.RenderTransform>
      </Image>
      <Border x:Name="CaptionBubble" Visibility="Collapsed" IsHitTestVisible="False"
              HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="360"
              MaxHeight="42" Margin="8,4,8,0" Padding="8,4"
              Background="#C8000000" CornerRadius="10">
        <TextBlock x:Name="CaptionText" Foreground="White" FontSize="12"
                   TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34" />
      </Border>
    </Grid>
  </Border>
</Window>
